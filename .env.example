# Kopieren nach .env und anpassen:  cp .env.example .env

# Domain. ":80" = lokal ohne HTTPS, "app.example.com" = automatisches HTTPS
SITE_ADDRESS=:80

# Images (ghcr.io/<orga>/<repo>, alles kleingeschrieben)
FRONTEND_IMAGE=ghcr.io/meine-orga/frontend
FRONTEND_TAG=latest
BACKEND_IMAGE=ghcr.io/meine-orga/backend
BACKEND_TAG=latest

# Datenbank
POSTGRES_USER=app
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=app
