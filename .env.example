# Copy to .env and adjust:  cp .env.example .env

# Domain. ":80" = local without HTTPS, "app.example.com" = automatic HTTPS
SITE_ADDRESS=:80

# Images (ghcr.io/<org>/<repo>, all lowercase)
FRONTEND_IMAGE=ghcr.io/simple-webapp-for-forking/frontend
FRONTEND_TAG=latest
BACKEND_IMAGE=ghcr.io/simple-webapp-for-forking/backend
BACKEND_TAG=latest

# Database
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
