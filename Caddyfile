# SITE_ADDRESS=":80"            -> HTTP only (local)
# SITE_ADDRESS="app.example.com" -> automatic HTTPS via Let's Encrypt
{$SITE_ADDRESS}

encode gzip

# Everything under /api goes to the backend (path stays unchanged)
handle /api/* {
	reverse_proxy backend:8080
}

# Everything else goes to the frontend
handle {
	reverse_proxy frontend:80
}
